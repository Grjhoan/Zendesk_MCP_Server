# Your account subdomain: if you sign in at https://acme.zendesk.com, it is "acme".
ZENDESK_SUBDOMAIN=acme

# --- Option A: OAuth (recommended by Zendesk) ---
# ZENDESK_OAUTH_TOKEN=

# --- Option B: API token (deprecated, but fine for a local prototype) ---
# The email must belong to the user who owns the token.
ZENDESK_EMAIL=you@company.com
ZENDESK_API_TOKEN=

# The write tools (reassign_tickets, set_user_status) fail while this is not
# true. Leave it off until you trust the server.
ZENDESK_ALLOW_WRITES=false
